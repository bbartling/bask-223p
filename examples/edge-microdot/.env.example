EDGE_ENABLE_SPARQL=0
EDGE_DB_MAX_MB=100
EDGE_POLL_INTERVAL=15
EDGE_FLUSH_INTERVAL=30

# BACnet profile (Pi 1). Must be the host's LAN CIDR, not 0.0.0.0.
EDGE_BACNET_ADDRESS=192.168.204.59/24
EDGE_BACNET_DEVICES=54545,5007

# Niagara profile (Pi 2). Use a read-only station user. Do not commit secrets.
NIAGARA_URL=https://192.168.204.11
NIAGARA_USER=
NIAGARA_PASS=
NIAGARA_INSECURE=1
BASK_BASE_ORD=slot:/Drivers
