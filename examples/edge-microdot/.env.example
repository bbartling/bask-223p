EDGE_ENABLE_SPARQL=0
EDGE_DB_MAX_MB=100
EDGE_POLL_INTERVAL=15
EDGE_FLUSH_INTERVAL=30
EDGE_MEMORY_RETENTION_HOURS=48
EDGE_RAM_ROWS=250000
EDGE_DUCKDB_MEMORY_MB=256
# SD card: Parquet snapshots and the log file land every N minutes.
# Leave EDGE_SNAPSHOT_INTERVAL unset so EDGE_DURABLE_MINUTES is the card cadence.
EDGE_SD_CARD=1
EDGE_DURABLE_MINUTES=15
EDGE_LOG_LEVEL=WARNING
EDGE_LOG_FILE=/tmp/edge-microdot.log
EDGE_LOG_FLUSH_MINUTES=15
# EDGE_SNAPSHOT_INTERVAL=300
# Self-hosted DuckDB-WASM (no CDN). Leave blank to use the vendored /static/vendor/duckdb files.
# EDGE_DUCKDB_WASM_URL=/static/vendor/duckdb/duckdb-browser.mjs
# EDGE_DUCKDB_WASM_BUNDLE_BASE=/static/vendor/duckdb

# Auth (required in production). Generate EDGE_USERS hashes offline; never commit secrets.
EDGE_SECRET_KEY=
EDGE_USERS=operator:pbkdf2_sha256$310000$YOUR_SALT$YOUR_HASH
EDGE_TOKEN_TTL=3600
EDGE_SESSION_TTL=3600
# EDGE_AUTH_DISABLED=1
# EDGE_ALLOW_UNAUTHENTICATED=1

# LAN TLS through Caddy. Names in EDGE_TLS_ALLOW (or EDGE_TLS_HOST) may get a
# certificate. The default site ":443" does not allow every name.
# EDGE_TLS_HOST=:443
# EDGE_TLS_ALLOW=edge.local
# EDGE_TLS_BIND=

# Native HTTPS (optional): paths inside the container or on the Pi host
# EDGE_SSL_CERT=/path/to/fullchain.pem
# EDGE_SSL_KEY=/path/to/privkey.pem

# BACnet profile (Pi 1). Bind to the host LAN CIDR — not 0.0.0.0.
# EDGE_BACNET_ADDRESS=host/prefix
EDGE_BACNET_DEVICES=54545,5007

# Niagara profile (Pi 2)
NIAGARA_URL=https://station.local
NIAGARA_USER=
NIAGARA_PASS=
NIAGARA_INSECURE=0
# NIAGARA_CA_FILE=/path/to/station-ca.pem
BASK_BASE_ORD=slot:/Drivers