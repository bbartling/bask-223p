# On unless set to 0. A 1 GB Pi can set 0.
EDGE_ENABLE_SPARQL=1
EDGE_DB_MAX_MB=100
EDGE_POLL_INTERVAL=15
EDGE_FLUSH_INTERVAL=30
EDGE_MEMORY_RETENTION_HOURS=48
EDGE_RAM_ROWS=250000
EDGE_DUCKDB_MEMORY_MB=256
# SD card: Parquet snapshots and the log file land every N minutes.
# Leave EDGE_SNAPSHOT_INTERVAL unset so EDGE_DURABLE_MINUTES is the card cadence.
EDGE_SD_CARD=1
EDGE_DURABLE_MINUTES=15
EDGE_LOG_LEVEL=WARNING
EDGE_LOG_FILE=/tmp/edge-microdot.log
EDGE_LOG_FLUSH_MINUTES=15
# EDGE_SNAPSHOT_INTERVAL=300

# Auth (required in production). Generate EDGE_USERS hashes offline; never commit secrets.
EDGE_SECRET_KEY=
EDGE_USERS=operator:pbkdf2_sha256$310000$YOUR_SALT$YOUR_HASH
EDGE_TOKEN_TTL=3600
EDGE_SESSION_TTL=3600
# EDGE_AUTH_DISABLED=1
# EDGE_ALLOW_UNAUTHENTICATED=1

# LAN TLS through Caddy. Names in EDGE_TLS_ALLOW (or EDGE_TLS_HOST) may get a
# certificate. The default site ":443" does not allow every name.
# EDGE_TLS_HOST=:443
# EDGE_TLS_ALLOW=edge.local
# EDGE_TLS_BIND=

# Native HTTPS (optional): paths inside the container or on the Pi host
# EDGE_SSL_CERT=/path/to/fullchain.pem
# EDGE_SSL_KEY=/path/to/privkey.pem

# BACnet profile (Pi 1). Bind to the host LAN CIDR — not 0.0.0.0.
# EDGE_BACNET_ADDRESS=host/prefix
EDGE_BACNET_DEVICES=54545,5007
# Used when --points is omitted. Compose mounts ./var at this path.
# CSV columns: device,object,property,units,label
# object is type,instance and must be quoted (it contains a comma).
# EDGE_POINTS_FILE=/app/examples/edge-microdot/var/points.csv
# Poll only a points file. Writes stay off. Raise the gap on MS/TP.
# EDGE_BACNET_MAX_INFLIGHT=1
# EDGE_BACNET_CHUNK_DELAY_S=0.05
# EDGE_BACNET_WHOIS_TIMEOUT=5
# EDGE_BACNET_READ_MAX=50
# EDGE_BACNET_ROUTE_AWARE=1
# EDGE_BACNET_WRITES_ENABLED=0
# EDGE_BACNET_ALLOW_PRIORITY_1_2=0
# EDGE_BACNET_AUDIT_LOG=var/bacnet-audit.log
# EDGE_BACNET_BBMD=
# EDGE_ROLES=operator:operator

# Share API. Public model exposes only GET /api/model.ttl. Publishing is off
# and the token is never logged. Site data may be sensitive.
# EDGE_PUBLIC_MODEL=0
# EDGE_EXPORT_RATE_LIMIT=12
# EDGE_EXPORT_RATE_WINDOW=60
# EDGE_PUBLISH_ENABLED=0
# EDGE_PUBLISH_TOKEN=
# EDGE_PUBLISH_REPO=owner/name
# EDGE_PUBLISH_KIND=release
# EDGE_PUBLISH_TAG=edge-share
# EDGE_PUBLISH_INTERVAL=86400

# Modbus TCP (optional extra: pip install 'edge-microdot[modbus]'). Reads only.
# EDGE_DRIVER=modbus
# EDGE_MODBUS_MAX_INFLIGHT=1
# EDGE_MODBUS_GAP_S=0.05

# Niagara profile (Pi 2)
NIAGARA_URL=https://station.local
NIAGARA_USER=
NIAGARA_PASS=
NIAGARA_INSECURE=0
# NIAGARA_CA_FILE=/path/to/station-ca.pem
BASK_BASE_ORD=slot:/Drivers