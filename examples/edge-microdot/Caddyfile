# TLS on the LAN. Microdot stays on 127.0.0.1. WebSocket upgrades are proxied as wss.
:443 {
	tls internal
	encode gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		-Server
	}
	request_body {
		max_size 1MB
	}
	reverse_proxy 127.0.0.1:8080
}
