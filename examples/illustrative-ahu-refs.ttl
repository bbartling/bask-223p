        <bacnet://10001/analog-input,13>,
        <bacnet://10001/analog-input,14>,
        <bacnet://10001/analog-input,15>,
        <bacnet://10001/analog-output,1>,
        <bacnet://10001/analog-output,2>,
        <bacnet://10001/analog-output,3>,
        <bacnet://10001/analog-output,4>,
        <bacnet://10001/analog-value,1>,
        <bacnet://10001/binary-input,1> ;
    bacnet:device-instance "10001"^^xsd:nonNegativeInteger ;
    bacnet2024:contains <bacnet://10001/analog-input,12>,
        <bacnet://10001/analog-input,13>,
        <bacnet://10001/analog-input,14>,
        <bacnet://10001/analog-input,15>,
        <bacnet://10001/analog-output,1>,
        <bacnet://10001/analog-output,2>,
        <bacnet://10001/analog-output,3>,
        <bacnet://10001/analog-output,4>,
        <bacnet://10001/analog-value,1>,
        <bacnet://10001/binary-input,1> ;
    bacnet2024:device-instance "10001"^^xsd:nonNegativeInteger .

